rules_version = '2';

// DENY ALL client access.
// MarketChat only talks to Firestore from the server through the Firebase Admin SDK,
// which bypasses these rules. That means nobody can read or write your data directly
// from a browser using the public Firebase web config.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

