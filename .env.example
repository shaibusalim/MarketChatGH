# Copy to .env (local) and set the same names in Vercel -> Settings -> Environment Variables.
# Use SEPARATE values for Production vs Preview (point Preview at a staging Firebase project).

# Firebase Admin (base64 of the service-account JSON)
FIREBASE_SERVICE_ACCOUNT_BASE64=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# NextAuth
NEXTAUTH_URL=http://localhost:9002
NEXTAUTH_SECRET=            # generate with: openssl rand -base64 32

# Public site URL
NEXT_PUBLIC_BASE_URL=http://localhost:9002

# Vercel Blob Storage (from Vercel Dashboard -> Storage -> your Blob store -> .env.local tab)
BLOB_READ_WRITE_TOKEN=

# Upstash Redis (rate limiting + shared cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Twilio / WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# Must equal the webhook URL configured in Twilio if your public URL differs from the request host
# TWILIO_WEBHOOK_URL=https://your-domain.com/api/whatsapp
# Debug only - NEVER enable in production:
# TWILIO_SKIP_SIGNATURE=true

# Google AI
GEMINI_API_KEY=
GOOGLE_API_KEY=

